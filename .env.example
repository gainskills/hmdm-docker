# To start Headwind MDM with docker-compose, copy this file to .env and update the variables
# This is the start with the most common options:
# HTTPS + Certbot/LetsEncrypt + PostgreSQL with the single database

SQL_BASE=hmdm
SQL_USER=hmdm
SQL_PASS=Ch@nGeMe
POSTGRES_IMAGE=postgres:16.15-alpine

ADMIN_EMAIL=info@h-mdm.com

SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SSL=0
SMTP_STARTTLS=1
SMTP_USERNAME=cinfo@example.com
SMTP_PASSWORD=changeme
SMTP_FROM=cinfo@example.com

# Hostname used for certificates and application identity.
BASE_DOMAIN=your-domain.com

# Compose maps BASE_DOMAIN to 127.0.0.1 inside HMDM for the embedded MQTT broker.
# Adjust extra_hosts in docker-compose.yaml if this hostname must resolve elsewhere.

# Turn on this parameter once you change variables!
# After a successful start, turn this parameter back off
#FORCE_RECONFIGURE=true

# Change to http for using plain HTTP instead of HTTPS
PROTOCOL=https
# Public application URL; defaults to PROTOCOL://BASE_DOMAIN.
# PUBLIC_BASE_URL=https://mdm.example.com

# Defaults to /etc/letsencrypt/live/BASE_DOMAIN inside the container.
# Override for custom mounts containing cert.pem, fullchain.pem and privkey.pem.
# HTTPS_CERT_PATH=/cert
# HTTPS_LETSENCRYPT=false

# false uses the embedded broker; true uses an external broker.
# MQTT_EXTERNAL=false
# Embedded broker port and Docker port mapping.
MQTT_PORT=31000
# Optional listener or external broker address; defaults to the port above.
# MQTT_SERVER_URI=tcp://0.0.0.0:31000
MQTT_ADMIN_PASSWORD=dd3V5YDkrX
SECURE_ENROLLMENT=0
JWT_SECRETKEY=20c68f0d9185b1d18cf6add1e8b491fd89529a44
JWT_VALIDITY=86400
JWT_VALIDITYREMEMBERME=2592000

# Update the shared secret in Premium setup: SHARED_SECRET=changeme-C3z9vi54
SHARED_SECRET=replace-with-a-long-random-value

HMDM_VARIANT=os
# Required explicitly; leave empty for public WAR downloads.
DOWNLOAD_CREDENTIALS=
HMDM_URL=https://mdm-files.gainskills.top/hmdm-java21.war
# Optional but recommended for pinned/versioned WAR files.
# HMDM_WAR_SHA256=
CLIENT_VERSION=6.30
